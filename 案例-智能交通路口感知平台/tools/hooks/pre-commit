#!/bin/bash
# @req SYS-REQ-001..010
# @author sw-hw-toolflow-team | @since 2026-06-04 | @version 1.0
# @status verified
# Git pre-commit hook 模板
# 复制到 .git/hooks/pre-commit 后启用

set -e
TOOLS_DIR="$(git rev-parse --show-toplevel)/tools"

echo "→ 运行 pre-commit 检查..."

# 1. ID 校验
python3 "$TOOLS_DIR/sw_hw_toolflow/core/validate_ids.py" core/ || {
    echo "✗ ID 校验失败"
    exit 1
}

# 2. Markdown 链接校验
python3 "$TOOLS_DIR/sw_hw_toolflow/core/check_links.py" core/ || {
    echo "✗ 链接校验失败"
    exit 1
}

# 3. Markdown Lint
python3 "$TOOLS_DIR/sw_hw_toolflow/core/lint_md.py" core/ || {
    echo "✗ Markdown 风格校验失败"
    exit 1
}

echo "✓ pre-commit 检查通过"
